# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:replace_me

# Your private key for calling /api/telegram and /api/set-webhook.
BOT_API_KEY=change_this_long_random_value

# Secret Telegram sends in X-Telegram-Bot-Api-Secret-Token for webhook calls.
TELEGRAM_WEBHOOK_SECRET=change_this_webhook_secret

# Optional. Use the official endpoint unless you run Telegram's local Bot API server.
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# Local development.
PORT=333
BOT_DRY_RUN=true
LOCAL_LONG_POLLING=false
